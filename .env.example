# Copy to .env.local for local development (never commit the real file).
# In production, set these in Vercel: Project -> Settings -> Environment Variables.

# Postgres connection string. If you connect a Postgres/Neon database via
# Vercel's Storage tab, this (or POSTGRES_URL) is added automatically —
# for local dev, run `vercel env pull .env.local` to fetch it.
DATABASE_URL=

# Admin portal login (shared credential). ADMIN_PASSWORD_HASH must be a
# bcrypt hash, not a plain password — generate one with:
#   node scripts/hash-password.mjs "your-chosen-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
